{
  "meta": {
    "aesthetic": "Dark dev-tool (Linear/Vercel/Raycast)",
    "fontStack": "Inter, system-ui, sans-serif",
    "monoFont": "JetBrains Mono, Fira Code, monospace",
    "borderRadius": "8px",
    "note": "shadcn/ui provides the component layer. These tokens extend the default shadcn dark theme."
  },
  "colors": {
    "background": {
      "base": "#09090b",
      "card": "#0f0f12",
      "elevated": "#18181b",
      "surface": "#1c1c20",
      "hover": "#27272a"
    },
    "foreground": {
      "primary": "#fafafa",
      "secondary": "#a1a1aa",
      "muted": "#71717a",
      "dim": "#52525b"
    },
    "border": {
      "default": "#27272a",
      "subtle": "#1e1e22",
      "active": "#3f3f46"
    },
    "accent": {
      "primary": "#6366f1",
      "primaryHover": "#818cf8",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "roles": {
      "human": "#6366f1",
      "assistant": "#22c55e",
      "system": "#71717a",
      "tool": "#f59e0b"
    },
    "sources": {
      "claude_code": "#6366f1",
      "claude_ai": "#ec4899"
    }
  },
  "spacing": {
    "page": "24px",
    "section": "16px",
    "element": "8px",
    "tight": "4px"
  },
  "typography": {
    "heading1": { "size": "24px", "weight": 600, "lineHeight": 1.2 },
    "heading2": { "size": "18px", "weight": 600, "lineHeight": 1.3 },
    "heading3": { "size": "14px", "weight": 600, "lineHeight": 1.4 },
    "body": { "size": "14px", "weight": 400, "lineHeight": 1.5 },
    "small": { "size": "12px", "weight": 400, "lineHeight": 1.4 },
    "mono": { "size": "13px", "weight": 400, "lineHeight": 1.5 }
  },
  "sidebar": {
    "width": "320px",
    "collapsedWidth": "0px",
    "breakpoint": "768px"
  },
  "commandPalette": {
    "width": "640px",
    "maxHeight": "400px",
    "backdropBlur": "8px"
  },
  "transitions": {
    "fast": "150ms ease",
    "default": "200ms ease",
    "slow": "300ms ease"
  }
}
